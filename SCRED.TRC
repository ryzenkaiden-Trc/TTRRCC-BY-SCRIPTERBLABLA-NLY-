local function sendHiguruma()
	TRC.allow = true
	local ok, err = pcall(switchCharacter, "Higuruma")
	TRC.allow = false
	if not ok then error(err, 0) end
end

local activeHold
local function holdSpawn(startCF)
	if activeHold then activeHold.stop() end
	local hold = { alive = true }
	local cf = startCF
	local conn = player.CharacterAdded:Connect(function(char)
		local root = char:WaitForChild("HumanoidRootPart", 5)
		if not (root and cf) then return end
		local t0 = os.clock()
		while hold.alive and char.Parent and os.clock() - t0 < 0.6 do
			char:PivotTo(cf)
			root.AssemblyLinearVelocity = Vector3.zero
			RunService.Heartbeat:Wait()
		end
	end)
	function hold.setCF(newCF) cf = newCF end
	function hold.stop()
		hold.alive = false
		conn:Disconnect()
		if activeHold == hold then activeHold = nil end
	end
	activeHold = hold
	return hold
end

local function watchHits(window)
	local state = { hit = false, kick = false }
	local humConn, bound, stopped = nil, false, false
	local t0 = os.clock()
	local function bind(char, confirmed)
		bound = true
		if humConn then humConn:Disconnect() end
		local hum = char and char:WaitForChild("Humanoid", 5)
		if not hum or stopped then return end
		local last = hum.Health
		local armed = os.clock() + 0.4
		humConn = hum.HealthChanged:Connect(function(h)
			if h < last and os.clock() >= armed then
				state.hit = true
				if confirmed and os.clock() - t0 <= window then state.kick = true end
			end
			last = h
		end)
	end
	local charConn = player.CharacterAdded:Connect(function(char) bind(char, true) end)
	task.delay(1.2, function()
		if not bound and player.Character then bind(player.Character, false) end
	end)
	function state.stop()
		stopped = true
		charConn:Disconnect()
		if humConn then humConn:Disconnect() end
	end
	return state
end

local gutsOwned
local chipByName = {}
local lastNotice = 0
local function notifyLocked(title, msg)
	if os.clock() - lastNotice < 2.5 then return end
	lastNotice = os.clock()
	local toast = showToast(title, msg, 0, 96)
	toast.fail(msg, title, 3.2)
end
local function lockChip(b)
	b:SetAttribute("Locked", true)
	b.Text = b.Text .. " (Locked)"
	b.TextTransparency = 0.5
	b.BackgroundColor3 = C.card
end

for i, name in ipairs(ULT_TARGETS) do
	local b = make("TextButton", { LayoutOrder = i, BackgroundColor3 = C.bar, Text = name, TextSize = 11,
		Font = Enum.Font.GothamMedium, TextColor3 = C.text, AutoButtonColor = false }, chipHolder)
	round(b, 6); outline(b, C.line)
	table.insert(chipBtns, b)
	chipByName[name] = b
	b.MouseButton1Click:Connect(function()
		if ultRunning then return end 
		if name == "Guts" and gutsOwned ~= true then
			if gutsOwned == nil then
				notifyLocked("Please wait", "Still checking your Early Access gamepass, try again in a moment.")
			else
				notifyLocked("Locked", GUTS_LOCKED_TEXT)
			end
			return
		end
		ultRunning = true
		for _, c in ipairs(chipBtns) do c.TextTransparency = 0.6 end 
		b.BackgroundColor3, b.TextColor3 = C.accent, C.onAccent
		lastLabel.Text = "Last: Higuruma > " .. name

		runUlt("Instant Ult (Higuruma > " .. name .. ")", function()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	assert(root, "character not found")
	local homeCF = root.CFrame + Vector3.new(0, 1.5, 0) 
	local ultCF = CFrame.new(ULT_TP_POS)

	local toast = showToast("Instant Ult", ("Wait for %d seconds. Make sure you don't get hit."):format(ULT_DELAY), ULT_DELAY)
	local hold = holdSpawn(ultCF)
	local hits = watchHits(KICK_WINDOW)
	local gotHit, kickNow = false, false
	local ok, err = pcall(function()
		char:PivotTo(ultCF) -- teleport to ult spot
		root.AssemblyLinearVelocity = Vector3.zero
		sendHiguruma()
		log("INFO", "Higuruma sent - switching to " .. name .. " in " .. ULT_DELAY .. "s")
		toast.countdown(ULT_DELAY, function() return hits.hit end)
		if hits.hit then
			gotHit = true
			kickNow = hits.kick
			return
		end
		hold.setCF(homeCF) 
		hits.stop()
		switchCharacter(name)
	end)
	hits.stop()
	task.delay(3, hold.stop)

	if gotHit or not ok then 
		hold.setCF(homeCF)
		local c = player.Character
		if c then c:PivotTo(homeCF) end
	end

	if ok and gotHit then
		toast.fail("You got hit! Instant Ult cancelled, try again.", nil, 2.5)
		if kickNow then
			task.wait(0.8)
			TRC.block()
		end
		error("you got hit during the countdown", 0)
	elseif ok then
		toast.done("Switched to " .. name .. ".")
	else
		toast.fail("Something went wrong. Check the Logs tab.")
		error(err, 0)
	end
end)

		b.BackgroundColor3, b.TextColor3 = C.bar, C.text
		for _, c in ipairs(chipBtns) do c.TextTransparency = c:GetAttribute("Locked") and 0.5 or 0 end
		ultRunning = false
	end)
end

task.spawn(function()
	local owned
	for _ = 1, 3 do
		local ok, res = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GUTS_GAMEPASS_ID)
		end)
		if ok then
			owned = res
			break
		end
		task.wait(1.5)
	end
	gutsOwned = (owned == true)
	if gutsOwned then
		log("OK", "Early Access gamepass found - Guts unlocked")
	else
		if chipByName.Guts then lockChip(chipByName.Guts) end
		if owned == nil then
			log("WARN", "Could not verify the Early Access gamepass - Guts stays locked")
		else
			log("WARN", "Guts locked - Early Access gamepass not owned (" .. GUTS_GAMEPASS_URL .. ")")
		end
	end
end)

task.spawn(function()
	while gui.Parent do
