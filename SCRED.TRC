	BackgroundTransparency = 1 }, uc)
make("UIGridLayout", { CellSize = UDim2.fromOffset(90, 28), CellPadding = UDim2.fromOffset(6, 6),
	SortOrder = Enum.SortOrder.LayoutOrder }, chipHolder)
local lastLabel = label(uc, "Ready", 12, C.sub, Enum.Font.GothamMedium,
	{ Position = UDim2.fromOffset(12, 118), Size = UDim2.fromOffset(300, 28) })
local ultBadge, ultLast = controls(uc, 118, 28)
local runUlt = makeRunner(ultBadge, ultLast)
local ultRunning, chipBtns = false, {}

for i, name in ipairs(ULT_TARGETS) do
	local b = make("TextButton", { LayoutOrder = i, BackgroundColor3 = C.bar, Text = name, TextSize = 11,
		Font = Enum.Font.GothamMedium, TextColor3 = C.text, AutoButtonColor = false }, chipHolder)
	round(b, 6); outline(b, C.line)
	table.insert(chipBtns, b)
	b.MouseButton1Click:Connect(function()
		if ultRunning then return end 
		ultRunning = true
		for _, c in ipairs(chipBtns) do c.TextTransparency = 0.6 end 
		b.BackgroundColor3, b.TextColor3 = C.accent, Color3.new(1, 1, 1)
		lastLabel.Text = "Last: Higuruma > " .. name

		runUlt("Instant Ult (Higuruma > " .. name .. ")", function()
			local toast = showToast("Instant Ult", ("Wait for %d seconds. Make sure you don't get hit."):format(ULT_DELAY), ULT_DELAY)
			local ok, err = pcall(function()
				switchCharacter("Higuruma")          
				log("INFO", "Higuruma sent - switching to " .. name .. " in " .. ULT_DELAY .. "s")
				toast.countdown(ULT_DELAY)           
				switchCharacter(name)                
			end)
			if ok then
				toast.done("Switched to " .. name .. ".")
			else
				toast.fail("Something went wrong. Check the Logs tab.")
				error(err, 0) 
			end
		end)

		b.BackgroundColor3, b.TextColor3 = C.bar, C.text
		for _, c in ipairs(chipBtns) do c.TextTransparency = 0 end
		ultRunning = false
	end)
end

