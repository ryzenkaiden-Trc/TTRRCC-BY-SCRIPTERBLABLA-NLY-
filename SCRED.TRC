		BorderSizePixel = 0, LayoutOrder = nextOrder() }, list)
	round(f, 8); outline(f, C.line)
	return f
end
local function controls(parent, y, h, runText)
	local badge = make("TextLabel", { Position = UDim2.fromOffset(330, y + (h - 18) / 2), Size = UDim2.fromOffset(62, 18),
		BackgroundColor3 = C.line, Text = "Idle", TextSize = 11, Font = Enum.Font.GothamBold, TextColor3 = C.text }, parent)
	round(badge, 5)
	local last = label(parent, "never", 12, C.sub, nil, { Position = UDim2.fromOffset(410, y), Size = UDim2.fromOffset(100, h) })
	local btn
	if runText then
		btn = make("TextButton", { Position = UDim2.fromOffset(510, y + (h - 26) / 2), Size = UDim2.fromOffset(88, 26),
			BackgroundColor3 = C.accent, Text = runText, TextSize = 12, Font = Enum.Font.GothamBold,
			TextColor3 = Color3.new(1, 1, 1) }, parent)
		round(btn, 6)
	end
	return badge, last, btn
end
local function makeRunner(badge, last)
	local lastTime
	table.insert(rowUpdaters, function() if lastTime then last.Text = ago(lastTime) end end)
	return function(name, fn)
		local ok, err = pcall(fn)
		lastTime = os.time()
		last.Text = "just now"
		ranCount += 1
		if ok then
			badge.Text, badge.BackgroundColor3 = "Ran", C.ok
			log("OK", name .. " executed")
		else
			badge.Text, badge.BackgroundColor3 = "Error", C.err
			log("ERROR", name .. " failed: " .. tostring(err))
		end
	end
end
local function bindRun(btn, name, fn, badge, last)
	local run = makeRunner(badge, last)
	btn.MouseButton1Click:Connect(function() run(name, fn) end)
end

local function tw(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end
local TOAST_IN  = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_OUT = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
local TOAST_FADE = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local function showToast(title, text, seconds)
	local shown, hidden = UDim2.new(0.5, 0, 0, 14), UDim2.new(0.5, 0, 0, -100)
	local shell = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = hidden,
		Size = UDim2.fromOffset(340, 80), BackgroundTransparency = 1 }, gui)
	round(shell, 12)
	local stroke = outline(shell, Color3.new(1, 1, 1), 1.5)
	stroke.Transparency = 1
	local grad = make("UIGradient", { Rotation = 0, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(236, 72, 153)),
		ColorSequenceKeypoint.new(0.5, C.accent),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(249, 115, 22)) }) }, stroke)

	local card = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bar,
		BorderSizePixel = 0, GroupTransparency = 1 }, shell)
	round(card, 12)

	local circle = make("Frame", { Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Color3.fromRGB(45, 38, 70), BorderSizePixel = 0 }, card)
	round(circle, 22)
	local ring = outline(circle, C.accent, 1.5)
	local pulse = make("UIScale", {}, circle)
	local num = label(circle, tostring(seconds), 20, C.text, Enum.Font.GothamBold,
		{ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	local titleLbl = label(card, title, 13, C.text, Enum.Font.GothamBold,
		{ Position = UDim2.fromOffset(70, 10), Size = UDim2.new(1, -82, 0, 16) })
	local bodyLbl = label(card, text, 12, C.sub, nil, { Position = UDim2.fromOffset(70, 28),
		Size = UDim2.new(1, -82, 0, 36), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local track = make("Frame", { Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = C.line, BorderSizePixel = 0 }, card)
	local fill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0 }, track)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(236, 72, 153), C.accent) }, fill)

	tw(shell, TOAST_IN, { Position = shown })
	tw(card, TOAST_FADE, { GroupTransparency = 0 })
	tw(stroke, TOAST_FADE, { Transparency = 0 })

	local alive = true
	task.spawn(function()
		while alive and shell.Parent do
			grad.Rotation = (grad.Rotation + 3) % 360
			task.wait()
		end
	end)

	local toast = {}
	function toast.countdown(secs)
		tw(fill, TweenInfo.new(secs, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) })
		local t0, shownN = os.clock(), nil
		while true do
			local left = secs - (os.clock() - t0)
			if left <= 0 then break end
			local n = math.ceil(left)
			if n ~= shownN then
				shownN = n
				num.Text = tostring(n)
				pulse.Scale = 1.25
				tw(pulse, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			end
			task.wait(0.05)
		end
		num.Text = "0"
	end
	function toast.close()
		alive = false
		tw(shell, TOAST_OUT, { Position = hidden })
		tw(card, TOAST_OUT, { GroupTransparency = 1 })
		tw(stroke, TOAST_OUT, { Transparency = 1 }).Completed:Connect(function() shell:Destroy() end)
	end
	local function finish(color, newTitle, newText, mark)
		titleLbl.Text, bodyLbl.Text, num.Text = newTitle, newText, mark
		num.TextSize = 14
		ring.Color = color
		tw(circle, TOAST_FADE, { BackgroundColor3 = color:Lerp(C.bar, 0.7) })
		tw(fill, TOAST_FADE, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color })
		pulse.Scale = 1.25
		tw(pulse, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		task.delay(1.6, toast.close)
	end
	function toast.done(msg) finish(C.ok, "Done", msg, "OK") end
	function toast.fail(msg) finish(C.err, "Failed", msg, "X") end
	return toast
end

header("INSTANT ULT")
local uc = card(156)
label(uc, "Instant Ult", 14, C.text, Enum.Font.GothamMedium,
	{ Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(400, 18) })
