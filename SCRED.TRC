local Lighting = game:GetService("Lighting")
local StatsService = game:GetService("Stats")
local RINGS = 10 

local MODS = {
	{ key = "rtx", name = "Graphic RTX", index = 600,
		desc = "Ray-tracing style look: bloom, sun rays, richer color and softer lighting. A visual preset, Roblox has no real RTX." },
	{ key = "dlss", name = "DLSS", index = 400,
		desc = "Max render quality plus a crisp, sharpened picture for a clean upscaled look. A visual preset, not real DLSS." },
	{ key = "hd4k", name = "HD 4K", index = 800,
		desc = "Pushes render quality and mesh detail to the maximum with vivid, high-contrast color." },
	{ key = "smooth", name = "SMOOTH", index = 300,
		desc = "Performance mode: lower quality, no shadows, fewer particles and effects for higher FPS." },
	{ key = "fps", name = "FPS Counter", index = 600, live = true,
		desc = "Live FPS and ping overlay with a lag detector. Turns red and logs a warning when your FPS drops." },
}
local FX, UI = {}, {}

do
	local function pset(o, k, v) pcall(function() o[k] = v end) end
	local function pget(o, k)
		local ok, v = pcall(function() return o[k] end)
		if ok then return v end
	end
	local function snapshot(list) 
		local saved = {}
		for _, e in ipairs(list) do table.insert(saved, { e[1], e[2], pget(e[1], e[2]) }) end
		return function()
			for _, s in ipairs(saved) do
				if s[3] ~= nil then pset(s[1], s[2], s[3]) end
			end
		end
	end
	local function effect(class, name, props) 
		local o = Lighting:FindFirstChild("TRC_" .. name)
		if not o then
			o = Instance.new(class)
			o.Name = "TRC_" .. name
			o.Parent = Lighting
		end
		for k, v in pairs(props) do pset(o, k, v) end
		return o
	end
	local function drop(...)
		for _, n in ipairs({ ... }) do
			local o = Lighting:FindFirstChild("TRC_" .. n)
			if o then o:Destroy() end
		end
	end
	local function setQuality(n)
		n = math.clamp(math.floor(n + 0.5), 1, 21)
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel["Level" .. string.format("%02d", n)] end)
	end

	local rtxBack, dlssBack, hdBack, smoothBack, muted
	FX.rtx = {
		apply = function(s)
			rtxBack = snapshot({ { Lighting, "GlobalShadows" }, { Lighting, "ShadowSoftness" },
				{ Lighting, "EnvironmentSpecularScale" }, { Lighting, "EnvironmentDiffuseScale" } })
			pset(Lighting, "GlobalShadows", true)
			pset(Lighting, "ShadowSoftness", 0.15)
			pset(Lighting, "EnvironmentSpecularScale", 0.6 + 0.4 * s)
			pset(Lighting, "EnvironmentDiffuseScale", 0.6 + 0.4 * s)
			effect("BloomEffect", "RTX_Bloom", { Intensity = 0.25 + 0.75 * s, Size = 24 + 28 * s, Threshold = 0.9 - 0.2 * s })
			effect("SunRaysEffect", "RTX_Rays", { Intensity = 0.04 + 0.16 * s, Spread = 0.7 })
			effect("ColorCorrectionEffect", "RTX_Color", { Contrast = 0.04 + 0.14 * s, Saturation = 0.05 + 0.2 * s, Brightness = 0.01 })
		end,
		remove = function()
			drop("RTX_Bloom", "RTX_Rays", "RTX_Color")
			if rtxBack then rtxBack(); rtxBack = nil end
		end,
	}
	FX.dlss = {
		apply = function(s)
			dlssBack = snapshot({ { settings().Rendering, "QualityLevel" } })
			setQuality(21)
			effect("ColorCorrectionEffect", "DLSS_Color", { Contrast = 0.05 + 0.1 * s, Saturation = 0.03 + 0.07 * s })
		end,
		remove = function()
			drop("DLSS_Color")
			if dlssBack then dlssBack(); dlssBack = nil end
		end,
	}
	FX.hd4k = {
		apply = function(s)
			hdBack = snapshot({ { settings().Rendering, "QualityLevel" }, { settings().Rendering, "MeshPartDetailLevel" } })
			setQuality(21)
			pset(settings().Rendering, "MeshPartDetailLevel", Enum.MeshPartDetailLevel.Level04)
			effect("ColorCorrectionEffect", "HD_Color", { Contrast = 0.06 + 0.12 * s, Saturation = 0.1 + 0.25 * s })
			effect("BloomEffect", "HD_Bloom", { Intensity = 0.1 + 0.2 * s, Size = 20, Threshold = 1.1 })
		end,
		remove = function()
			drop("HD_Color", "HD_Bloom")
			if hdBack then hdBack(); hdBack = nil end
		end,
	}
	FX.smooth = {
		apply = function(s)
			local terrain = workspace:FindFirstChildOfClass("Terrain")
			local list = { { settings().Rendering, "QualityLevel" }, { Lighting, "GlobalShadows" } }
			if terrain then
				table.insert(list, { terrain, "WaterWaveSize" })
				table.insert(list, { terrain, "WaterWaveSpeed" })
			end
			smoothBack = snapshot(list)
			setQuality(12 - s * 10)
			if s > 0.3 then pset(Lighting, "GlobalShadows", false) end
			if terrain then
				pset(terrain, "WaterWaveSize", 0)
				pset(terrain, "WaterWaveSpeed", 0)
			end
			muted = {}
			for _, d in ipairs(workspace:GetDescendants()) do
				if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke")
					or d:IsA("Fire") or d:IsA("Sparkles") then
					if pget(d, "Enabled") then
						pset(d, "Enabled", false)
						table.insert(muted, d)
					end
				end
			end
			for _, e in ipairs(Lighting:GetChildren()) do
				if e:IsA("PostEffect") and e.Name:sub(1, 4) ~= "TRC_" and pget(e, "Enabled") then
					pset(e, "Enabled", false)
					table.insert(muted, e)
				end
			end
		end,
		remove = function()
			if muted then
				for _, o in ipairs(muted) do
					if o.Parent then pset(o, "Enabled", true) end
				end
				muted = nil
			end
			if smoothBack then smoothBack(); smoothBack = nil end
		end,
	}
end

do
	local hud = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, -100),
		Size = UDim2.fromOffset(150, 76), BackgroundColor3 = C.bar, BorderSizePixel = 0, Visible = false }, gui)
	round(hud, 10)
	outline(hud, C.accent, 1.2)
	local fpsLbl = label(hud, "60", 28, C.ok, Enum.Font.GothamBold, { Position = UDim2.fromOffset(12, 3), Size = UDim2.fromOffset(66, 32) })
	label(hud, "FPS", 10, C.sub, Enum.Font.GothamBold, { Position = UDim2.fromOffset(13, 33), Size = UDim2.fromOffset(40, 12) })
	label(hud, "PING", 9, C.sub, Enum.Font.GothamBold, { Position = UDim2.fromOffset(84, 8), Size = UDim2.fromOffset(50, 11) })
	local pingLbl = label(hud, "-- ms", 13, C.text, Enum.Font.GothamBold, { Position = UDim2.fromOffset(84, 18), Size = UDim2.fromOffset(62, 16) })
	local stLbl = label(hud, "Smooth", 11, C.ok, Enum.Font.GothamBold, { Position = UDim2.fromOffset(84, 34), Size = UDim2.fromOffset(62, 14) })
	local holder = make("Frame", { Position = UDim2.fromOffset(12, 54), Size = UDim2.fromOffset(126, 16),
		BackgroundTransparency = 1 }, hud)
	local bars = {}
	for i = 1, 30 do
		bars[i] = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromOffset((i - 1) * 4.2, 16),
			Size = UDim2.fromOffset(3, 2), BackgroundColor3 = C.ok, BorderSizePixel = 0 }, holder)
	end

	local on, samples, acc, frames, lastLag = false, {}, 0, 0, 0
	local function statusFor(fps)
		if fps < 20 then return C.err, "LAGGING" end
		if fps < 45 then return C.warn, "Unstable" end
		return C.ok, "Smooth"
	end
	local function render(fps)
		local color, text = statusFor(fps)
		fpsLbl.Text, fpsLbl.TextColor3 = tostring(fps), color
		stLbl.Text, stLbl.TextColor3 = text, color
		local ok, ping = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		pingLbl.Text = ok and (math.floor(ping + 0.5) .. " ms") or "-- ms"
		table.insert(samples, fps)
		if #samples > 30 then table.remove(samples, 1) end
		for i = 1, 30 do
			local v = samples[#samples - 30 + i]
			if v then
				bars[i].Size = UDim2.fromOffset(3, math.clamp(v / 90, 0.08, 1) * 16)
				bars[i].BackgroundColor3 = (statusFor(v))
			else
				bars[i].Size = UDim2.fromOffset(3, 2)
				bars[i].BackgroundColor3 = C.line
			end
		end
		if fps < 20 and os.clock() - lastLag > 5 then
			lastLag = os.clock()
			log("WARN", "Lag spike: " .. fps .. " FPS")
		end
		if UI.onFps then UI.onFps(fps) end
	end
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		if not on then return end
		acc += dt; frames += 1
		if acc >= 0.25 then
			local fps = math.floor(frames / acc + 0.5)
			acc, frames = 0, 0
			render(fps)
		end
	end))

	FX.fps = {
		apply = function()
			on, acc, frames, samples = true, 0, 0, {}
			hud.Visible = true
			hud.Position = UDim2.new(1, -12, 0, -100)
			tw(hud, TOAST_IN, { Position = UDim2.new(1, -12, 0, 12) })
		end,
		remove = function()
			on = false
			tw(hud, TOAST_OUT, { Position = UDim2.new(1, -12, 0, -100) }).Completed:Connect(function()
				if not on then hud.Visible = false end
			end)
		end,
	}
end

do
	local mp = newPage("Mods")
	local mcard = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.card, BorderSizePixel = 0 }, mp)
	round(mcard, 10)
	make("UIGradient", { Rotation = 25, Color = CHROME }, outline(mcard, Color3.new(1, 1, 1), 1))

	label(mcard, "Graphics Mods", 13, C.text, Enum.Font.GothamMedium, { Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(140, 16) })
	label(mcard, "Tap a mod to select it", 11, C.sub, nil, { Position = UDim2.fromOffset(14, 27), Size = UDim2.fromOffset(130, 14) })
	local activeLbl = label(mcard, "", 11, C.sub, Enum.Font.GothamMedium, { AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 10), Size = UDim2.fromOffset(100, 16), TextXAlignment = Enum.TextXAlignment.Right })

	local CX, CY, R0, RSTEP, THICK, R_OUT = 300, 86, 11, 5.2, 3, 60
	local DIM = Color3.fromRGB(34, 35, 40)
	local LOW, MED, HIGH = Color3.fromRGB(105, 108, 116), Color3.fromRGB(160, 165, 176), C.accent
	local selected, fpsNow, sectors = MODS[1], 60, {}

	local info = make("Frame", { Position = UDim2.fromOffset(12, 172), Size = UDim2.new(1, -24, 0, 100),
		BackgroundColor3 = C.bg, BorderSizePixel = 0 }, mcard)
	round(info, 8)
	outline(info, C.line)
	label(info, "v", 11, C.sub, Enum.Font.GothamBold, { Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(12, 18) })
	label(info, "Selected mod:", 11, C.sub, nil, { Position = UDim2.fromOffset(28, 8), Size = UDim2.fromOffset(84, 18) })
	local infoName = label(info, "", 12, C.text, Enum.Font.GothamBold, { Position = UDim2.fromOffset(112, 8), Size = UDim2.fromOffset(240, 18) })
	local badge = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(84, 18), BackgroundColor3 = Color3.fromRGB(222, 226, 232), Text = "", TextSize = 10,
		Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(20, 20, 24) }, info)
	round(badge, 5)
	local infoDesc = label(info, "", 11, C.sub, nil, { Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 32),
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local sdot = make("Frame", { Position = UDim2.fromOffset(12, 77), Size = UDim2.fromOffset(9, 9),
		BackgroundColor3 = C.line, BorderSizePixel = 0 }, info)
	round(sdot, 5)
	local statusTxt = label(info, "", 11, C.text, nil, { Position = UDim2.fromOffset(28, 72), Size = UDim2.fromOffset(160, 18) })
	local tbtn = make("TextButton", { Position = UDim2.new(1, -106, 0, 68), Size = UDim2.fromOffset(94, 26),
		BackgroundColor3 = C.accent, Text = "Turn ON", TextSize = 12, Font = Enum.Font.GothamBold,
		TextColor3 = C.onAccent }, info)
	round(tbtn, 6)
	local function stepBtn(txt, x)
		local b = make("TextButton", { Position = UDim2.new(1, x, 0, 70), Size = UDim2.fromOffset(24, 22),
			BackgroundColor3 = C.bar, Text = txt, TextSize = 14, Font = Enum.Font.GothamBold,
			TextColor3 = C.text }, info)
		round(b, 6); outline(b, C.line)
		return b
	end
	local minus, plus = stepBtn("-", -236), stepBtn("+", -138)
	local valLbl = label(info, "", 12, C.text, Enum.Font.GothamBold, { Position = UDim2.new(1, -208, 0, 70),
		Size = UDim2.fromOffset(66, 22), TextXAlignment = Enum.TextXAlignment.Center })

	local function ringColor(m, i) 
		if i > m.index / 100 + 0.001 then return DIM end
		local base = (m.index < 100 and LOW) or (m.index < 300 and MED) or HIGH
		local c = Color3.fromRGB(255, 255, 255):Lerp(base, (i - 1) / (RINGS - 1))
		return m.on and c or c:Lerp(DIM, 0.62) 
	end
	local function paint(m, animate)
		for i = 1, RINGS do
			local color, segs = ringColor(m, i), sectors[m.slot][i]
			local function go()
				for _, f in ipairs(segs) do
					if animate then tw(f, TOAST_FADE, { BackgroundColor3 = color }) else f.BackgroundColor3 = color end
				end
			end
			if animate then task.delay((i - 1) * 0.03, go) else go() end
		end
	end

	local function refreshInfo()
		local m = selected
		infoName.Text, infoDesc.Text = m.name, m.desc
		badge.Text = m.live and (m.on and (fpsNow .. " FPS") or "LIVE") or (m.index .. "/1000")
		valLbl.Text = tostring(m.index)
		minus.Visible, plus.Visible, valLbl.Visible = not m.live, not m.live, not m.live
		sdot.BackgroundColor3 = m.on and C.ok or C.line
		statusTxt.Text = m.on and "Status: Enabled" or "Status: Disabled"
		tbtn.Text = m.on and "Turn OFF" or "Turn ON"
		tw(tbtn, TOAST_FADE, { BackgroundColor3 = m.on and Color3.fromRGB(52, 54, 60) or C.accent,
			TextColor3 = m.on and C.text or C.onAccent })
	end
	local function updateActive()
		local n = 0
		for _, m in ipairs(MODS) do if m.on then n += 1 end end
		activeLbl.Text = n .. "/" .. #MODS .. " active"
	end
	local function choose(m)
		selected = m
		for _, x in ipairs(MODS) do
			x.dot.BackgroundTransparency = (x == m) and 0 or 1
			x.lbl.TextColor3 = (x == m) and C.text or C.sub
		end
		refreshInfo()
	end
	local function setMod(m, on)
		if on == (m.on == true) then return end
		if on then
			local ok, err = pcall(FX[m.key].apply, m.index / 1000)
			if not ok then
				pcall(FX[m.key].remove)
				log("ERROR", m.name .. " failed: " .. tostring(err))
				return
			end
			m.on = true
			log("OK", m.name .. " enabled" .. (m.live and "" or (" (" .. m.index .. "/1000)")))
		else
			pcall(FX[m.key].remove)
			m.on = false
			log("INFO", m.name .. " disabled")
		end
		paint(m, true)
		refreshInfo()
		updateActive()
	end
	local function change(d)
		local m = selected
		if m.live then return end
		m.index = math.clamp(m.index + d, 0, 1000)
		paint(m, true)
		refreshInfo()
		if m.on then 
			pcall(FX[m.key].remove)
			local ok, err = pcall(FX[m.key].apply, m.index / 1000)
			if not ok then log("ERROR", m.name .. " failed: " .. tostring(err)) end
		end
	end
	tbtn.MouseButton1Click:Connect(function() setMod(selected, not selected.on) end)
	minus.MouseButton1Click:Connect(function() change(-100) end)
	plus.MouseButton1Click:Connect(function() change(100) end)

	local function drawSector(k)
		local center = 36 + 72 * (k - 1)
		local a0, a1 = center - 34, center + 34
		local rings = {}
		for i = 1, RINGS do
			local r = R0 + (i - 1) * RSTEP
			local n = math.max(3, math.ceil(r * math.rad(a1 - a0) / 5))
			local da = (a1 - a0) / n
			local len = 2 * r * math.sin(math.rad(da) / 2) + 1
			local segs = {}
			for j = 1, n do
				local ang = a0 + (j - 0.5) * da
				local rad = math.rad(ang)
				segs[j] = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(CX + r * math.sin(rad), CY - r * math.cos(rad)),
					Size = UDim2.fromOffset(len, THICK), Rotation = ang, BackgroundColor3 = DIM,
					BorderSizePixel = 0 }, mcard)
			end
			rings[i] = segs
		end
		sectors[k] = rings
	end
	local hub = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(CX, CY),
		Size = UDim2.fromOffset(9, 9), BackgroundColor3 = Color3.fromRGB(235, 238, 243), BorderSizePixel = 0 }, mcard)
	round(hub, 5)

	for k, m in ipairs(MODS) do
		m.slot = k
		drawSector(k)
		local ang = math.rad(36 + 72 * (k - 1))
		local sx, sy = math.sin(ang), -math.cos(ang)
		local dx, dy = CX + (R_OUT + 14) * sx, CY + (R_OUT + 14) * sy
		m.dot = make("Frame", { Position = UDim2.fromOffset(dx - 4.5, dy - 4.5), Size = UDim2.fromOffset(9, 9),
			BackgroundColor3 = HIGH, BackgroundTransparency = 1, BorderSizePixel = 0 }, mcard)
		round(m.dot, 5)
		outline(m.dot, C.accent, 1.6)
		local left = sx < -0.1
		m.lbl = make("TextButton", { Position = UDim2.fromOffset(left and (dx - 14 - 90) or (dx + 14), dy - 9),
			Size = UDim2.fromOffset(90, 18), BackgroundTransparency = 1, Text = m.name, TextSize = 12,
			Font = Enum.Font.GothamMedium, TextColor3 = C.sub, AutoButtonColor = false,
			TextXAlignment = left and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left }, mcard)
		m.lbl.MouseButton1Click:Connect(function() choose(m) end)
		local hit = make("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(CX + 36 * sx, CY + 36 * sy), Size = UDim2.fromOffset(34, 34),
			BackgroundTransparency = 1, Text = "" }, mcard)
		hit.MouseButton1Click:Connect(function() choose(m) end)
	end

	for i, e in ipairs({ { LOW, "0 to 99 index. Low" }, { MED, "100 to 299 index. Medium" }, { HIGH, "300 to 1000 index. High" } }) do
		local y = 98 + (i - 1) * 20
		local d = make("Frame", { Position = UDim2.fromOffset(466, y + 3), Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = e[1], BorderSizePixel = 0 }, mcard)
		round(d, 5)
		label(mcard, e[2], 11, C.sub, nil, { Position = UDim2.fromOffset(484, y), Size = UDim2.fromOffset(130, 16) })
	end

	UI.onFps = function(fps)
		fpsNow = fps
		local m = MODS[5]
		local idx = math.clamp(math.floor(fps / 6 + 0.5), 0, RINGS) * 100
		if m.index ~= idx then
			m.index = idx
			paint(m, true)
		end
		if selected == m then refreshInfo() end
	end

	for _, m in ipairs(MODS) do paint(m, false) end
	choose(MODS[1])
	updateActive()
end

gui.Destroying:Connect(function()
	for _, m in ipairs(MODS) do
		if m.on then pcall(FX[m.key].remove) end
	end
end)

local toggle = make("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 54, 0.5, 0),
	Size = UDim2.fromOffset(84, 34), BackgroundColor3 = C.bar, Text = "Close", TextSize = 13,
	Font = Enum.Font.GothamBold, TextColor3 = C.text, AutoButtonColor = false }, gui)
round(toggle, 17)
outline(toggle, C.accent, 1.5)
local toggleScale = make("UIScale", {}, toggle)
local statusDot = make("Frame", { Position = UDim2.fromOffset(12, 13), Size = UDim2.fromOffset(8, 8),
	BackgroundColor3 = C.ok, BorderSizePixel = 0 }, toggle)
round(statusDot, 4)

local EASE = {
	scaleIn = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),   
	moveIn  = TweenInfo.new(0.60, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),  
	fadeIn  = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
	item    = TweenInfo.new(0.50, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),  
	out     = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In),   
	pop     = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	release = TweenInfo.new(0.30, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	shine   = TweenInfo.new(0.90, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
}
local function tween(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local shine = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
	BorderSizePixel = 0, ZIndex = 50 }, body)
local shineGrad = make("UIGradient", { Rotation = 25, Offset = Vector2.new(-1, 0),
	Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 1),
		NumberSequenceKeypoint.new(0.5, 0.88), NumberSequenceKeypoint.new(0.6, 1),
		NumberSequenceKeypoint.new(1, 1) }) }, shine)

table.insert(conns, RunService.Heartbeat:Connect(function(dt)
	if main.Visible then borderGrad.Rotation = (borderGrad.Rotation + dt * 70) % 360 end
end))

local intro = {}
local function reg(obj, delay, dx, dy)
	table.insert(intro, { obj = obj, pos = obj.Position, delay = delay, off = UDim2.fromOffset(dx, dy) })
end
for i, t in ipairs({ "Total Scripts", "Ran Today", "Log Entries", "Errors" }) do
	reg(statLabels[t].Parent, 0.10 + i * 0.05, 0, 16)
end
for i, n in ipairs(order) do
	reg(navBtns[n], 0.10 + i * 0.05, -16, 0)
	reg(tabs[n].btn, 0.30 + i * 0.04, 0, 10)
end
reg(pageArea, 0.42, 0, 16)

local token = 0
local function playIntro(mine)
	for _, e in ipairs(intro) do
		e.obj.Position = e.pos + e.off
		task.delay(e.delay, function()
			if token == mine then tween(e.obj, EASE.item, { Position = e.pos }) end
		end)
	end
end

setOpen = function(state)
	if state == isOpen then return end
	isOpen = state
	token += 1
	local mine = token

	toggle.Text = state and "Close" or "Open"
	tween(toggle, EASE.fadeIn, { BackgroundColor3 = state and C.bar or C.accent,
		TextColor3 = state and C.text or C.onAccent })
	tween(statusDot, EASE.fadeIn, { BackgroundColor3 = state and C.ok or C.onAccent })

	busy = true
	if state then
		main.Visible = true
		scale.Scale = baseScale * 0.75
		main.Position = restPos + UDim2.fromOffset(0, 30)
		body.GroupTransparency = 1
		mainStroke.Transparency = 1
		tween(scale, EASE.scaleIn, { Scale = baseScale })
		tween(main, EASE.moveIn, { Position = restPos })
		tween(body, EASE.fadeIn, { GroupTransparency = 0 })
		tween(mainStroke, EASE.fadeIn, { Transparency = 0 })
		playIntro(mine)
		shineGrad.Offset = Vector2.new(-1, 0)
		task.delay(0.2, function()
			if token == mine then tween(shineGrad, EASE.shine, { Offset = Vector2.new(1, 0) }) end
		end)
		task.delay(0.6, function() if token == mine then busy = false end end)
	else
		tween(scale, EASE.out, { Scale = baseScale * 0.88 })
		tween(main, EASE.out, { Position = restPos + UDim2.fromOffset(0, 20) })
		tween(body, EASE.out, { GroupTransparency = 1 })
		local t = tween(mainStroke, EASE.out, { Transparency = 1 })
		t.Completed:Connect(function()
			if token == mine then
				main.Visible = false
				main.Position = restPos
				busy = false
			end
		end)
	end
end

local function press(down)
	tween(toggleScale, down and EASE.pop or EASE.release, { Scale = down and 0.9 or 1 })
end
local function isPointer(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local tDrag, tMoved = false, false
local tStart, tOrigin = Vector2.new(), Vector2.new()
toggle.InputBegan:Connect(function(i)
	if not isPointer(i) then return end
	local sz, p = gui.AbsoluteSize, toggle.Position
	tDrag, tMoved = true, false
	tStart = Vector2.new(i.Position.X, i.Position.Y)
	tOrigin = Vector2.new(p.X.Scale * sz.X + p.X.Offset, p.Y.Scale * sz.Y + p.Y.Offset)
	press(true)
	i.Changed:Connect(function()
		if i.UserInputState == Enum.UserInputState.End and tDrag then
			tDrag = false
			press(false)
			if not tMoved then setOpen(not isOpen) end 
		end
	end)
end)
table.insert(conns, UIS.InputChanged:Connect(function(i)
	if not tDrag then return end
	if i.UserInputType ~= Enum.UserInputType.MouseMovement
		and i.UserInputType ~= Enum.UserInputType.Touch then return end
	local d = Vector2.new(i.Position.X, i.Position.Y) - tStart
	if not tMoved and d.Magnitude < 6 then return end 
	tMoved = true
	local sz, p = gui.AbsoluteSize, tOrigin + d
	toggle.Position = UDim2.fromScale(math.clamp(p.X, 42, sz.X - 42) / sz.X,
		math.clamp(p.Y, 17, sz.Y - 17) / sz.Y) 
end))

hookClicks(gui)

log("INFO", "Dashboard loaded")
log("INFO", "Welcome, " .. player.Name)
for _, n in ipairs(bootNotes) do log(n[1], n[2]) end
switchPage("Script")
refreshStats()

isOpen = false
main.Visible = false
toggleScale.Scale = 0
task.delay(0.35, function() tween(toggleScale, EASE.release, { Scale = 1 }) end)
setOpen(true)
