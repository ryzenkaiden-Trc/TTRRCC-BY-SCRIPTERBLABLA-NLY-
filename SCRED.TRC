		BackgroundColor3 = C.accent, BorderSizePixel = 0, Visible = false }, b)
	local badge = make("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -2, 0.5, 0),
		Size = UDim2.fromOffset(28, 16), BackgroundColor3 = C.card, Text = "0", TextSize = 10,
