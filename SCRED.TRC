]==] },
}

local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function decodeBase64(data)
	data = data:gsub("%s", "")
	local lookup = {}
	for i = 1, 64 do lookup[B64_CHARS:byte(i)] = i - 1 end
	local out, n = {}, 0
	for i = 1, #data, 4 do
		local c1, c2, c3, c4 = data:byte(i, i + 3)
		local v = lookup[c1] * 262144 + lookup[c2] * 4096 + (lookup[c3] or 0) * 64 + (lookup[c4] or 0)
		local x1 = math.floor(v / 65536)
		local x2 = math.floor(v / 256) % 256
		local x3 = v % 256
		n += 1
		if not lookup[c3] then out[n] = string.char(x1)
		elseif not lookup[c4] then out[n] = string.char(x1, x2)
		else out[n] = string.char(x1, x2, x3) end
	end
	return table.concat(out)
end

local function sfxSource(cfg)
	if cfg.Id ~= "" then return "rbxassetid://" .. tostring(cfg.Id) end
	if not (isfile and writefile and getcustomasset) then
		note("WARN", cfg.File .. ": executor has no isfile/writefile/getcustomasset - set Id in SFX_CONFIG")
		return nil
	end
	local ok, src = pcall(function()
		local embed = cfg.Embed and AUDIO[cfg.Embed]
		local need = not isfile(cfg.File)
		if embed and not need and readfile then
			local okRead, current = pcall(readfile, cfg.File)
			need = (not okRead) or #current ~= embed.Size
		end
		if need then
			if embed then
				writefile(cfg.File, decodeBase64(embed.B64))
			elseif cfg.Url ~= "" then
				writefile(cfg.File, game:HttpGet(cfg.Url))
			else
				error("file not found and no embedded audio", 0)
			end
		end
		return getcustomasset(cfg.File)
	end)
	if ok and src then return src end
	note("WARN", cfg.File .. ": " .. tostring(src))
	return nil
end
local function loadSfx(key)
	local cfg = SFX_CONFIG[key]
	local src = sfxSource(cfg)
	if not src then return end
	local s = Instance.new("Sound")
	s.Name = "TRC_SFX_" .. key
	s.SoundId = src
	s.Volume = cfg.Volume
	s.Parent = SoundService
	SFX[key] = s
end
local function playSfx(key)
	local s = SFX[key]
	if s then
		s.TimePosition = 0
		s:Play()
	end
end
local function playClick() playSfx("Click") end
local function hookClicks(root)
	local function hook(d)
		if d:IsA("TextButton") then d.MouseButton1Click:Connect(playClick) end
	end
	for _, d in ipairs(root:GetDescendants()) do hook(d) end
	root.DescendantAdded:Connect(hook)
end

local function showLocked()
	local old = playerGui:FindFirstChild("TRC_Locked")
	if old then old:Destroy() end
	local g = make("ScreenGui", { Name = "TRC_Locked", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = 1000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)

	local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 24),
		Size = UDim2.fromOffset(440, 270), BackgroundTransparency = 1, BorderSizePixel = 0 }, g)
	round(win, 12)
	local stroke = outline(win, Color3.new(1, 1, 1), 1.5)
	stroke.Transparency = 1
	local grad = make("UIGradient", { Rotation = 45, Color = CHROME }, stroke)
	local body = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BorderSizePixel = 0,
		GroupTransparency = 1 }, win)
	round(body, 12)

	local sc = make("UIScale", {}, win)
	local cam = workspace.CurrentCamera
	local function fit()
		if not cam then return end
		local v = cam.ViewportSize
		sc.Scale = math.clamp(math.min(v.X / 480, v.Y / 310), 0.5, 1)
	end
	fit()
	local conns = {}
	if cam then table.insert(conns, cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)) end
	table.insert(conns, RunService.Heartbeat:Connect(function(dt) grad.Rotation = (grad.Rotation + dt * 70) % 360 end))
	g.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)

	local icon = make("Frame", { Position = UDim2.new(0.5, -18, 0, 20), Size = UDim2.fromOffset(36, 38), BackgroundTransparency = 1 }, body)
	local shackle = make("Frame", { Position = UDim2.fromOffset(8, 2), Size = UDim2.fromOffset(20, 22), BackgroundTransparency = 1 }, icon)
	round(shackle, 10)
	outline(shackle, C.accent, 3.5)
	local lockBody = make("Frame", { Position = UDim2.fromOffset(2, 14), Size = UDim2.fromOffset(32, 24),
		BackgroundColor3 = C.accent, BorderSizePixel = 0 }, icon)
	round(lockBody, 6)
	local keyhole = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(5, 9), BackgroundColor3 = C.bg, BorderSizePixel = 0 }, lockBody)
	round(keyhole, 2)

	label(body, "ACCESS RESTRICTED", 16, C.text, Enum.Font.GothamBold,
		{ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	label(body, LOCKED_TEXT, 13, C.text, Enum.Font.GothamMedium,
		{ Position = UDim2.fromOffset(30, 94), Size = UDim2.new(1, -60, 0, 44), TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })

	local linkBox = make("TextBox", { Position = UDim2.fromOffset(30, 148), Size = UDim2.new(1, -60, 0, 32),
		BackgroundColor3 = C.console, BorderSizePixel = 0, Text = DISCORD_LINK, TextSize = 13, Font = Enum.Font.GothamMedium,
		TextColor3 = C.info, ClearTextOnFocus = false, TextEditable = false }, body)
	round(linkBox, 6)
	outline(linkBox, C.line)

	local copyBtn = make("TextButton", { Position = UDim2.fromOffset(30, 192), Size = UDim2.fromOffset(222, 34),
		BackgroundColor3 = C.accent, BorderSizePixel = 0, Text = "Copy Discord Link", TextSize = 13,
		Font = Enum.Font.GothamBold, TextColor3 = C.onAccent }, body)
	round(copyBtn, 8)
	local closeBtn = make("TextButton", { Position = UDim2.fromOffset(262, 192), Size = UDim2.fromOffset(148, 34),
		BackgroundColor3 = C.bar, BorderSizePixel = 0, Text = "Close", TextSize = 13,
		Font = Enum.Font.GothamBold, TextColor3 = C.text }, body)
	round(closeBtn, 8)
	outline(closeBtn, C.line)

	local status = label(body, "", 11, C.ok, Enum.Font.GothamMedium,
		{ Position = UDim2.fromOffset(30, 238), Size = UDim2.new(1, -60, 0, 16), TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center })
	local function doCopy()
		if copyToClipboard(DISCORD_LINK) then
			status.Text, status.TextColor3 = "Discord link copied to clipboard!", C.ok
		else
			status.Text, status.TextColor3 = "Clipboard not available - select the link above and copy it.", C.warn
		end
	end
	doCopy() 
	copyBtn.MouseButton1Click:Connect(doCopy)

	closeBtn.MouseButton1Click:Connect(function()
		local out = TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		TweenService:Create(body, out, { GroupTransparency = 1 }):Play()
		TweenService:Create(stroke, out, { Transparency = 1 }):Play()
		task.delay(0.22, function() g:Destroy() end)
	end)
	hookClicks(g)

	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(win, info, { Position = UDim2.fromScale(0.5, 0.5) }):Play()
	TweenService:Create(body, info, { GroupTransparency = 0 }):Play()
	TweenService:Create(stroke, info, { Transparency = 0 }):Play()
end

