	navIcons[name] = buildIcon(name, nb)
end

local function switchPage(name)
	for n, p in pairs(pages) do p.Visible = (n == name) end
	for n, t in pairs(tabs) do
		t.ul.Visible = (n == name)
		t.btn.TextColor3 = (n == name) and C.text or C.sub
	end
	for n, b in pairs(navBtns) do
		b.BackgroundColor3 = (n == name) and Color3.fromRGB(45, 38, 70) or C.bg
		b.TextColor3 = (n == name) and C.accent or C.sub
	end
	for n, ic in pairs(navIcons) do ic.set((n == name) and C.accent or C.sub) end
end
for n, t in pairs(tabs) do t.btn.MouseButton1Click:Connect(function() switchPage(n) end) end
for n, b in pairs(navBtns) do b.MouseButton1Click:Connect(function() switchPage(n) end) end

local function newPage(name)
	local p = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, pageArea)
	pages[name] = p
	return p
end

local logList
local logCount, errCount, ranCount, logOrder = 0, 0, 0, 0

local function refreshStats()
	statLabels["Total Scripts"].Text = tostring(SCRIPT_COUNT)
	statLabels["Ran Today"].Text = tostring(ranCount)
	statLabels["Log Entries"].Text = tostring(logCount)
	statLabels["Errors"].Text = tostring(errCount)
	tabs.Script.badge.Text = tostring(SCRIPT_COUNT)
	tabs.Credit.badge.Text = tostring(#CREDITS)
	tabs.Mods.badge.Text = tostring(MOD_COUNT)
	tabs.Logs.badge.Text = tostring(logCount)
end

local function log(level, msg)
	logCount += 1; logOrder += 1
	if level == "ERROR" then errCount += 1 end
	if logList then
		label(logList, ("[%s] [%s] %s"):format(os.date("%H:%M:%S"), level, msg), 12,
			LEVEL_COLOR[level] or C.text, Enum.Font.Code,
			{ Size = UDim2.new(1, -8, 0, 16), LayoutOrder = logOrder, TextTruncate = Enum.TextTruncate.AtEnd })
		task.defer(function() logList.CanvasPosition = Vector2.new(0, logList.AbsoluteCanvasSize.Y) end)
	end
	refreshStats()
end

