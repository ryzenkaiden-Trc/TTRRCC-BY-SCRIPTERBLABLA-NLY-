local ENV = (getgenv and getgenv()) or _G
local TRC = ENV.TRC_STATE
if not TRC then
	TRC = { allow = false, hooked = false }
	ENV.TRC_STATE = TRC
end
TRC.kicked = false
TRC.block = function()
	if TRC.kicked then return end
	TRC.kicked = true
	pcall(function() player:Kick(HIGURUMA_KICK_REASON) end)
end
if not TRC.hooked then
	if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
		local installed = pcall(function()
			local oldNamecall
			local function handler(self, ...)
				local method = getnamecallmethod()
				if not TRC.allow and (method == "FireServer" or method == "InvokeServer")
					and typeof(self) == "Instance" and self.Name == "SwitchCharacter" then
					local first = ...
					if type(first) == "string" and first:lower() == "higuruma" then
						task.defer(TRC.block)
						return nil
					end
				end
				return oldNamecall(self, ...)
			end
			oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
		end)
		TRC.hooked = installed
	end
end

