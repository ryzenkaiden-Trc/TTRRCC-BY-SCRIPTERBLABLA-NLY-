		Font = Enum.Font.GothamBold, TextColor3 = C.text }, b)
	round(badge, 4); outline(badge, C.line)
	tabs[name] = { btn = b, ul = ul, badge = badge }

	local nb = make("TextButton", { Position = UDim2.fromOffset(8, 12 + (i - 1) * 46),
		Size = UDim2.fromOffset(36, 36), BackgroundColor3 = C.bg, Text = "", TextSize = 14,
		Font = Enum.Font.GothamBold, TextColor3 = C.sub, AutoButtonColor = false }, side)
	round(nb, 8)
	navBtns[name] = nb
	navIcons[name] = buildIcon(name, nb)
end

local function switchPage(name)
	for n, p in pairs(pages) do p.Visible = (n == name) end
	for n, t in pairs(tabs) do
		t.ul.Visible = (n == name)
		t.btn.TextColor3 = (n == name) and C.text or C.sub
	end
	for n, b in pairs(navBtns) do
		b.BackgroundColor3 = (n == name) and C.sel or C.bg
		b.TextColor3 = (n == name) and C.accent or C.sub
	end
	for n, ic in pairs(navIcons) do ic.set((n == name) and C.accent or C.sub) end
end
for n, t in pairs(tabs) do t.btn.MouseButton1Click:Connect(function() switchPage(n) end) end
for n, b in pairs(navBtns) do b.MouseButton1Click:Connect(function() switchPage(n) end) end

local function newPage(name)
	local p = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, pageArea)
	pages[name] = p
	return p
end

local logList
local logCount, errCount, ranCount, logOrder = 0, 0, 0, 0

local function refreshStats()
	statLabels["Total Scripts"].Text = tostring(SCRIPT_COUNT)
	statLabels["Ran Today"].Text = tostring(ranCount)
	statLabels["Log Entries"].Text = tostring(logCount)
	statLabels["Errors"].Text = tostring(errCount)
	tabs.Script.badge.Text = tostring(SCRIPT_COUNT)
	tabs.Credit.badge.Text = tostring(#CREDITS)
	tabs.Mods.badge.Text = tostring(MOD_COUNT)
	tabs.Logs.badge.Text = tostring(logCount)
end

local function log(level, msg)
	logCount += 1; logOrder += 1
	if level == "ERROR" then errCount += 1 end
	if logList then
		label(logList, ("[%s] [%s] %s"):format(os.date("%H:%M:%S"), level, msg), 12,
			LEVEL_COLOR[level] or C.text, Enum.Font.Code,
			{ Size = UDim2.new(1, -8, 0, 16), LayoutOrder = logOrder, TextTruncate = Enum.TextTruncate.AtEnd })
		task.defer(function() logList.CanvasPosition = Vector2.new(0, logList.AbsoluteCanvasSize.Y) end)
	end
	refreshStats()
end

local sp = newPage("Script")
local list = make("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
	BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new() }, sp)
make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
make("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4) }, list)

local layoutIdx, rowUpdaters = 0, {}
local function nextOrder() layoutIdx += 1; return layoutIdx end

local function header(text)
	label(list, text, 10, C.sub, Enum.Font.GothamBold, { Size = UDim2.new(1, -8, 0, 16), LayoutOrder = nextOrder() })
end
local function card(h)
	local f = make("Frame", { Size = UDim2.new(1, -10, 0, h), BackgroundColor3 = C.card,
		BorderSizePixel = 0, LayoutOrder = nextOrder() }, list)
	round(f, 8); outline(f, C.line)
	return f
end
local function controls(parent, y, h, runText)
	local badge = make("TextLabel", { Position = UDim2.fromOffset(330, y + (h - 18) / 2), Size = UDim2.fromOffset(62, 18),
		BackgroundColor3 = C.line, Text = "Idle", TextSize = 11, Font = Enum.Font.GothamBold, TextColor3 = C.text }, parent)
	round(badge, 5)
	local last = label(parent, "never", 12, C.sub, nil, { Position = UDim2.fromOffset(410, y), Size = UDim2.fromOffset(100, h) })
	local btn
	if runText then
		btn = make("TextButton", { Position = UDim2.fromOffset(510, y + (h - 26) / 2), Size = UDim2.fromOffset(88, 26),
			BackgroundColor3 = C.accent, Text = runText, TextSize = 12, Font = Enum.Font.GothamBold,
			TextColor3 = C.onAccent }, parent)
		round(btn, 6)
	end
	return badge, last, btn
end
local function makeRunner(badge, last)
	local lastTime
	table.insert(rowUpdaters, function() if lastTime then last.Text = ago(lastTime) end end)
	return function(name, fn)
		local ok, err = pcall(fn)
		lastTime = os.time()
		last.Text = "just now"
		ranCount += 1
		if ok then
			badge.Text, badge.BackgroundColor3 = "Ran", C.ok
			log("OK", name .. " executed")
		else
			badge.Text, badge.BackgroundColor3 = "Error", C.err
			log("ERROR", name .. " failed: " .. tostring(err))
		end
	end
end
local function bindRun(btn, name, fn, badge, last)
	local run = makeRunner(badge, last)
	btn.MouseButton1Click:Connect(function() run(name, fn) end)
end

local function tw(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end
local TOAST_IN  = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_OUT = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
local TOAST_FADE = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local function showToast(title, text, seconds, height)
	height = height or 80
	local shown, hidden = UDim2.new(0.5, 0, 0, 14), UDim2.new(0.5, 0, 0, -100)
	local shell = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = hidden,
		Size = UDim2.fromOffset(340, height), BackgroundTransparency = 1 }, gui)
	round(shell, 12)
	local stroke = outline(shell, Color3.new(1, 1, 1), 1.5)
	stroke.Transparency = 1
	local grad = make("UIGradient", { Rotation = 0, Color = CHROME }, stroke)

	local card = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bar,
		BorderSizePixel = 0, GroupTransparency = 1 }, shell)
	round(card, 12)

	local circle = make("Frame", { Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = C.sel, BorderSizePixel = 0 }, card)
	round(circle, 22)
	local ring = outline(circle, C.accent, 1.5)
	local pulse = make("UIScale", {}, circle)
	local num = label(circle, tostring(seconds), 20, C.text, Enum.Font.GothamBold,
		{ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	local titleLbl = label(card, title, 13, C.text, Enum.Font.GothamBold,
		{ Position = UDim2.fromOffset(70, 10), Size = UDim2.new(1, -82, 0, 16) })
	local bodyLbl = label(card, text, 12, C.sub, nil, { Position = UDim2.fromOffset(70, 28),
		Size = UDim2.new(1, -82, 0, height - 44), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local track = make("Frame", { Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = C.line, BorderSizePixel = 0 }, card)
	local fill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0 }, track)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(110, 114, 122), Color3.fromRGB(245, 247, 250)) }, fill)

	tw(shell, TOAST_IN, { Position = shown })
	tw(card, TOAST_FADE, { GroupTransparency = 0 })
	tw(stroke, TOAST_FADE, { Transparency = 0 })

	local alive = true
	task.spawn(function()
		while alive and shell.Parent do
			grad.Rotation = (grad.Rotation + 3) % 360
			task.wait()
		end
	end)

	local toast = {}
	function toast.countdown(secs, abort)
		tw(fill, TweenInfo.new(secs, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) })
		local t0, shownN = os.clock(), nil
		while true do
			if abort and abort() then return end
			local left = secs - (os.clock() - t0)
			if left <= 0 then break end
			local n = math.ceil(left)
			if n ~= shownN then
				shownN = n
				num.Text = tostring(n)
				pulse.Scale = 1.25
				tw(pulse, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			end
			task.wait(0.05)
		end
		num.Text = "0"
	end
	function toast.close()
		alive = false
		tw(shell, TOAST_OUT, { Position = hidden })
		tw(card, TOAST_OUT, { GroupTransparency = 1 })
		tw(stroke, TOAST_OUT, { Transparency = 1 }).Completed:Connect(function() shell:Destroy() end)
	end
	local function finish(color, newTitle, newText, mark, hold)
		titleLbl.Text, bodyLbl.Text, num.Text = newTitle, newText, mark
		num.TextSize = 14
		ring.Color = color
		tw(circle, TOAST_FADE, { BackgroundColor3 = color:Lerp(C.bar, 0.7) })
		tw(fill, TOAST_FADE, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color })
		pulse.Scale = 1.25
		tw(pulse, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		task.delay(hold or 1.6, toast.close)
	end
	function toast.done(msg, ttl, hold) finish(C.ok, ttl or "Done", msg, "OK", hold) end
	function toast.fail(msg, ttl, hold) finish(C.err, ttl or "Failed", msg, "X", hold) end
	return toast
end

header("INSTANT ULT")
local uc = card(156)
label(uc, "Instant Ult", 14, C.text, Enum.Font.GothamMedium,
	{ Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(400, 18) })
label(uc, "Choose you Character :)", 11, C.sub, nil,
	{ Position = UDim2.fromOffset(12, 27), Size = UDim2.fromOffset(580, 14) })

local chipHolder = make("Frame", { Position = UDim2.fromOffset(12, 50), Size = UDim2.fromOffset(580, 62),
	BackgroundTransparency = 1 }, uc)
make("UIGridLayout", { CellSize = UDim2.fromOffset(90, 28), CellPadding = UDim2.fromOffset(6, 6),
	SortOrder = Enum.SortOrder.LayoutOrder }, chipHolder)
local lastLabel = label(uc, "Ready", 12, C.sub, Enum.Font.GothamMedium,
	{ Position = UDim2.fromOffset(12, 118), Size = UDim2.fromOffset(300, 28) })
