local function buildIcon(kind, parent)
	local box = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1 }, parent)
	local fills, strokes, texts = {}, {}, {}
	local function shape(props, par, radius)
		props.BorderSizePixel = 0
		props.BackgroundColor3 = C.sub
		local f = make("Frame", props, par or box)
		if radius then round(f, radius) end
		table.insert(fills, f)
		return f
	end
	if kind == "Script" then 
		local doc = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(13, 17), BackgroundTransparency = 1 }, box)
		round(doc, 3)
		table.insert(strokes, outline(doc, C.sub, 1.6))
		for i = 0, 2 do
			shape({ Position = UDim2.fromOffset(2.5, 4 + i * 4), Size = UDim2.fromOffset(8, 1.6) }, doc, 1)
		end
	elseif kind == "Credit" then 
		shape({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 1.5),
			Size = UDim2.fromOffset(9, 9) }, nil, 5)
		local clip = make("Frame", { Position = UDim2.fromOffset(2, 13), Size = UDim2.fromOffset(18, 7),
			BackgroundTransparency = 1, ClipsDescendants = true }, box)
		shape({ Size = UDim2.fromOffset(18, 18) }, clip, 9)
	elseif kind == "Logs" then 
		for k = 0, 7 do
			local a = math.rad(k * 45)
			shape({ AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(11 + 7.4 * math.sin(a), 11 - 7.4 * math.cos(a)),
				Size = UDim2.fromOffset(4, 5), Rotation = k * 45 }, nil, 1)
		end
		local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(9, 9), BackgroundTransparency = 1 }, box)
		round(ring, 5)
		table.insert(strokes, outline(ring, C.sub, 2.6))
	else 
		table.insert(texts, label(box, "</>", 12, C.sub, Enum.Font.GothamBold,
			{ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center }))
	end
	local function set(color)
		for _, f in ipairs(fills) do f.BackgroundColor3 = color end
		for _, s in ipairs(strokes) do s.Color = color end
		for _, t in ipairs(texts) do t.TextColor3 = color end
	end
	set(C.sub)
	return { set = set }
end

