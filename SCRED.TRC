local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local WHITELIST = {
	"redskycatlol2",
	"KENZOM_5",
	"IRENGpintar_87",
	"xiomu51",
}

local WHITELIST_IDS = {
}

local DISCORD_LINK = "https://discord.gg/TvU9ycm295" 
local LOCKED_TEXT = "To access the script you need to buy it first.\nTo buy it, join our Discord server."

local CONFIG = { Title = "TRC SERVICE", ToggleKey = Enum.KeyCode.RightShift }

local CREDITS = {
	{ "Created by", "Scripterblabla", 5585997690 },
	{ "Developed by", "Redsky", 7225921293 },
	{ "Version", "1.0.0" },
}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CHARACTER_ID = "136505645200132"
local ULT_TARGETS = { "Gojo", "Accelerator", "Kratos", "Reigen", "Chara", "Anubis", "Edgerunner", "Hornet", "Mori", "Edward", "Guts"}
local MOD_COUNT = 5 
local SCRIPT_COUNT = 1 

local function switchCharacter(name)
	local args = { name, CHARACTER_ID }
	local remote = ReplicatedStorage:WaitForChild("Remotes", 5)
	remote = remote and remote:WaitForChild("Combat", 5)
	remote = remote and remote:WaitForChild("SwitchCharacter", 5)
	assert(remote, "SwitchCharacter remote not found")
	remote:FireServer(unpack(args))
end

local ULT_DELAY = 3

local C = {
	bg = Color3.fromRGB(18, 20, 29), bar = Color3.fromRGB(25, 27, 38),
	card = Color3.fromRGB(22, 24, 34), line = Color3.fromRGB(48, 52, 70),
	text = Color3.fromRGB(235, 237, 245), sub = Color3.fromRGB(140, 146, 168),
	accent = Color3.fromRGB(168, 85, 247), console = Color3.fromRGB(12, 13, 19),
	ok = Color3.fromRGB(34, 197, 94), warn = Color3.fromRGB(245, 158, 11),
	err = Color3.fromRGB(239, 68, 68), info = Color3.fromRGB(96, 165, 250),
}
local LEVEL_COLOR = { INFO = C.info, OK = C.ok, WARN = C.warn, ERROR = C.err }

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function outline(o, color, t)
	return make("UIStroke", { Color = color, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function label(parent, str, size, color, font, props)
	local p = { Text = str, TextSize = size, TextColor3 = color or C.text, Font = font or Enum.Font.Gotham,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props or {}) do p[k] = v end
	return make("TextLabel", p, parent)
end
local function ago(t)
	local d = os.time() - t
	if d < 5 then return "just now" elseif d < 60 then return d .. "s ago"
	elseif d < 3600 then return math.floor(d / 60) .. "m ago" end
	return math.floor(d / 3600) .. "h ago"
end

local function isWhitelisted(plr)
	local name = plr.Name:lower()
	for _, n in ipairs(WHITELIST) do
		if type(n) == "string" and n:lower() == name then return true end
	end
	for _, id in ipairs(WHITELIST_IDS) do
		if id == plr.UserId then return true end
	end
	return false
end

local function copyToClipboard(text)
	local fn = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
	if type(fn) ~= "function" then return false end
	return (pcall(fn, text))
end

local function showLocked()
	local old = playerGui:FindFirstChild("TRC_Locked")
	if old then old:Destroy() end
	local g = make("ScreenGui", { Name = "TRC_Locked", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = 1000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)

	local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 24),
		Size = UDim2.fromOffset(440, 270), BackgroundTransparency = 1, BorderSizePixel = 0 }, g)
	round(win, 12)
	local stroke = outline(win, Color3.new(1, 1, 1), 1.5)
	stroke.Transparency = 1
	local grad = make("UIGradient", { Rotation = 45, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(236, 72, 153)),
		ColorSequenceKeypoint.new(0.33, C.accent),
		ColorSequenceKeypoint.new(0.66, Color3.fromRGB(249, 115, 22)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(236, 72, 153)) }) }, stroke)
	local body = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BorderSizePixel = 0,
		GroupTransparency = 1 }, win)
	round(body, 12)

	local sc = make("UIScale", {}, win)
	local cam = workspace.CurrentCamera
	local function fit()
		if not cam then return end
		local v = cam.ViewportSize
		sc.Scale = math.clamp(math.min(v.X / 480, v.Y / 310), 0.5, 1)
	end
	fit()
	local conns = {}
	if cam then table.insert(conns, cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)) end
	table.insert(conns, RunService.Heartbeat:Connect(function(dt) grad.Rotation = (grad.Rotation + dt * 70) % 360 end))
	g.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)

	local icon = make("Frame", { Position = UDim2.new(0.5, -18, 0, 20), Size = UDim2.fromOffset(36, 38), BackgroundTransparency = 1 }, body)
	local shackle = make("Frame", { Position = UDim2.fromOffset(8, 2), Size = UDim2.fromOffset(20, 22), BackgroundTransparency = 1 }, icon)
	round(shackle, 10)
	outline(shackle, C.accent, 3.5)
	local lockBody = make("Frame", { Position = UDim2.fromOffset(2, 14), Size = UDim2.fromOffset(32, 24),
		BackgroundColor3 = C.accent, BorderSizePixel = 0 }, icon)
	round(lockBody, 6)
	local keyhole = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(5, 9), BackgroundColor3 = C.bg, BorderSizePixel = 0 }, lockBody)
	round(keyhole, 2)

	label(body, "ACCESS RESTRICTED", 16, C.text, Enum.Font.GothamBold,
		{ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	label(body, LOCKED_TEXT, 13, C.text, Enum.Font.GothamMedium,
		{ Position = UDim2.fromOffset(30, 94), Size = UDim2.new(1, -60, 0, 44), TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top })

	local linkBox = make("TextBox", { Position = UDim2.fromOffset(30, 148), Size = UDim2.new(1, -60, 0, 32),
		BackgroundColor3 = C.console, BorderSizePixel = 0, Text = DISCORD_LINK, TextSize = 13, Font = Enum.Font.GothamMedium,
		TextColor3 = C.info, ClearTextOnFocus = false, TextEditable = false }, body)
	round(linkBox, 6)
	outline(linkBox, C.line)

	local copyBtn = make("TextButton", { Position = UDim2.fromOffset(30, 192), Size = UDim2.fromOffset(222, 34),
		BackgroundColor3 = C.accent, BorderSizePixel = 0, Text = "Copy Discord Link", TextSize = 13,
		Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1) }, body)
	round(copyBtn, 8)
	local closeBtn = make("TextButton", { Position = UDim2.fromOffset(262, 192), Size = UDim2.fromOffset(148, 34),
		BackgroundColor3 = C.bar, BorderSizePixel = 0, Text = "Close", TextSize = 13,
		Font = Enum.Font.GothamBold, TextColor3 = C.text }, body)
	round(closeBtn, 8)
	outline(closeBtn, C.line)

	local status = label(body, "", 11, C.ok, Enum.Font.GothamMedium,
		{ Position = UDim2.fromOffset(30, 238), Size = UDim2.new(1, -60, 0, 16), TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center })
	local function doCopy()
		if copyToClipboard(DISCORD_LINK) then
			status.Text, status.TextColor3 = "Discord link copied to clipboard!", C.ok
		else
			status.Text, status.TextColor3 = "Clipboard not available - select the link above and copy it.", C.warn
		end
	end
	doCopy() 
	copyBtn.MouseButton1Click:Connect(doCopy)

	closeBtn.MouseButton1Click:Connect(function()
		local out = TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		TweenService:Create(body, out, { GroupTransparency = 1 }):Play()
		TweenService:Create(stroke, out, { Transparency = 1 }):Play()
		task.delay(0.22, function() g:Destroy() end)
	end)

	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(win, info, { Position = UDim2.fromScale(0.5, 0.5) }):Play()
	TweenService:Create(body, info, { GroupTransparency = 0 }):Play()
	TweenService:Create(stroke, info, { Transparency = 0 }):Play()
end

if not isWhitelisted(player) then
	warn("[TRC] " .. player.Name .. " is not whitelisted")
	showLocked()
	return 
end

local old = playerGui:FindFirstChild("DashboardGui")
if old then old:Destroy() end
local gui = make("ScreenGui", { Name = "DashboardGui", ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)

local main = make("Frame", { Size = UDim2.fromOffset(700, 440), Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
round(main, 12)
local mainStroke = outline(main, Color3.new(1, 1, 1), 1.5)
local borderGrad = make("UIGradient", { Rotation = 45, Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(236, 72, 153)),
	ColorSequenceKeypoint.new(0.33, C.accent),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(249, 115, 22)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(236, 72, 153)) }) }, mainStroke)

local body = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg,
	BorderSizePixel = 0 }, main)
round(body, 12)

local scale = make("UIScale", {}, main)
local cam = workspace.CurrentCamera
local baseScale, isOpen = 1, true
local restPos, busy = main.Position, false 
local setOpen 
local function fit()
	local v = cam.ViewportSize
	baseScale = math.clamp(math.min(v.X / 740, v.Y / 480), 0.5, 1)
	if isOpen then scale.Scale = baseScale end
end
fit()
cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

local bar = make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.bar, BorderSizePixel = 0 }, body)
round(bar, 12) 
make("Frame", { Position = UDim2.new(0, 0, 1, -12), Size = UDim2.new(1, 0, 0, 12),
	BackgroundColor3 = C.bar, BorderSizePixel = 0 }, bar) 
make("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1),
	BackgroundColor3 = C.line, BorderSizePixel = 0 }, bar)
local function dot(x, color, cb)
	local b = make("TextButton", { Size = UDim2.fromOffset(11, 11), Position = UDim2.fromOffset(x, 10),
		BackgroundColor3 = color, Text = "", AutoButtonColor = false }, bar)
	round(b, 6)
	if cb then b.MouseButton1Click:Connect(cb) end
end
dot(12, C.err, function()
	setOpen(false)
	task.delay(0.35, function() gui:Destroy() end)
end)
dot(28, C.warn, function() setOpen(false) end)
dot(44, Color3.fromRGB(70, 74, 92))
label(bar, CONFIG.Title, 12, C.sub, Enum.Font.GothamMedium,
	{ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })

local dragging, dragStart, startPos
bar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		if busy then return end
		dragging, dragStart, startPos = true, i.Position, main.Position
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
local conns = {}
table.insert(conns, UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
		local d = (i.Position - dragStart) / scale.Scale
		main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y)
		restPos = main.Position
	end
end))
table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == CONFIG.ToggleKey then setOpen(not isOpen) end
end))
